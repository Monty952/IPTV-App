<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:background="@color/bg_primary" android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:orientation="vertical" android:paddingBottom="40dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="280dp">
                <ImageView android:id="@+id/ivDetailsBackdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_movie" android:scaleType="centerCrop"/>
                <View android:background="@drawable/bg_hero_gradient" android:layout_width="match_parent" android:layout_height="match_parent"/>
                <ImageButton android:id="@+id/btnDetailsBack" android:background="@drawable/bg_pill_action" android:visibility="gone" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginTop="16dp" android:src="@drawable/ic_back" android:layout_marginStart="16dp" app:tint="@color/brand_blue"/>
                <androidx.cardview.widget.CardView android:layout_width="100dp" android:layout_height="145dp" android:layout_marginBottom="12dp" android:layout_alignParentBottom="true" android:layout_marginStart="16dp" android:layout_alignParentStart="true" app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="10dp" app:cardElevation="6dp">
                    <ImageView android:id="@+id/ivDetailsPoster" android:background="@color/bg_channel_thumb" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_movie" android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:layout_alignParentBottom="true" android:layout_marginStart="128dp" android:layout_marginEnd="16dp">
                    <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/white" android:ellipsize="end" android:id="@+id/tvDetailsTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sample_big_buck_bunny" android:maxLines="2"/>
                    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp">
                        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_badge_number" android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="6dp" android:paddingEnd="6dp">
                            <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_star_amber" android:layout_marginEnd="3dp"/>
                            <TextView android:textSize="11sp" android:textStyle="bold" android:textColor="#0f172a" android:id="@+id/tvDetailsRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sample_rating_8_1"/>
                        </LinearLayout>
                        <TextView android:textSize="12sp" android:textColor="#cbd5e1" android:id="@+id/tvDetailsYear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sample_year_2023" android:layout_marginStart="8dp"/>
                        <TextView android:textSize="12sp" android:textColor="#cbd5e1" android:id="@+id/tvDetailsDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sample_duration_120" android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:textSize="12sp" android:textStyle="bold" android:textColor="@color/brand_blue" android:id="@+id/tvDetailsGenre" android:background="@drawable/bg_chip_genre" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/sample_genres_anim_comedy" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <com.google.android.material.button.MaterialButton android:textSize="15sp" android:textStyle="bold" android:textColor="@color/white" android:id="@+id/btnDetailsPlay" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:text="@string/vod_play_movie" android:backgroundTint="@color/brand_blue" app:cornerRadius="12dp"/>
                <com.google.android.material.button.MaterialButton android:textSize="13sp" android:textColor="@color/text_secondary" android:id="@+id/btnDetailsRestart" android:visibility="gone" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="@string/vod_start_beginning" app:cornerRadius="12dp" app:strokeColor="@color/card_stroke" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true">
                    <LinearLayout android:orientation="horizontal" android:id="@+id/llAdsView" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </RelativeLayout>
                <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/vod_overview_storyline"/>
                <TextView android:textSize="13sp" android:textColor="@color/text_secondary" android:id="@+id/tvDetailsPlot" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/sample_plot_detailed" android:lineSpacingMultiplier="1.2"/>
                <LinearLayout android:orientation="vertical" android:id="@+id/layoutDetailsCast" android:background="@drawable/bg_poster_card" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                    <TextView android:textSize="12sp" android:textColor="@color/text_secondary" android:id="@+id/tvDetailsCast" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sample_cast"/>
                    <TextView android:textSize="12sp" android:textColor="@color/text_secondary" android:id="@+id/tvDetailsDirector" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/sample_director"/>
                </LinearLayout>
                <LinearLayout android:orientation="vertical" android:id="@+id/layoutSeriesSection" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp">
                    <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vod_seasons_episodes"/>
                    <androidx.recyclerview.widget.RecyclerView android:orientation="horizontal" android:id="@+id/rvSeasons" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="12dp" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvEpisodes" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ProgressBar android:layout_gravity="center" android:id="@+id/detailsProgressBar" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:indeterminateTint="@color/brand_blue"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
