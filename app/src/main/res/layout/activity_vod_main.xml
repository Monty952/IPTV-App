<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:background="@color/bg_primary" android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/vodTopBar" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp">
        <ImageButton android:id="@+id/btnVodBack" android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_back" app:tint="@color/icon_tint_primary"/>
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp">
            <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary" android:id="@+id/tvVodDashboardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vod_hub_title"/>
            <TextView android:textSize="12sp" android:textColor="@color/text_secondary" android:id="@+id/tvVodDashboardSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vod_hub_subtitle"/>
        </LinearLayout>
        <ImageButton android:id="@+id/btnVodSearchToggle" android:background="?attr/selectableItemBackgroundBorderless" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_search" app:tint="@color/icon_tint_primary"/>
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/layoutVodSearch" android:background="@drawable/bg_search_input" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_search" app:tint="@color/text_secondary"/>
        <EditText android:textSize="14sp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:id="@+id/etVodSearch" android:background="@null" android:layout_width="0dp" android:layout_height="44dp" android:hint="@string/search_vod_hint" android:layout_weight="1" android:inputType="text" android:imeOptions="actionSearch" android:layout_marginStart="8dp"/>
        <ImageButton android:id="@+id/btnVodClearSearch" android:background="?attr/selectableItemBackgroundBorderless" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_clear" app:tint="@color/text_secondary"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:background="@drawable/bg_segmented_container" android:padding="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp">
        <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/white" android:gravity="center" android:id="@+id/tabVodMovies" android:background="@drawable/bg_segmented_tab_selected" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="38dp" android:text="@string/vod_tab_movies" android:layout_weight="1"/>
        <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_secondary" android:gravity="center" android:id="@+id/tabVodSeries" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="38dp" android:text="@string/vod_tab_series" android:layout_weight="1"/>
        <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_secondary" android:gravity="center" android:id="@+id/tabVodContinue" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="38dp" android:text="@string/vod_tab_resume" android:layout_weight="1"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:orientation="horizontal" android:id="@+id/rvVodCategories" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <RelativeLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipeRefreshVod" android:layout_width="match_parent" android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvVodItems" android:paddingBottom="20dp" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="10dp" android:paddingEnd="10dp"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <ProgressBar android:id="@+id/vodProgressBar" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:indeterminateTint="@color/brand_blue"/>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/layoutVodEmpty" android:padding="20dp" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_movie" app:tint="@color/text_muted"/>
            <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_primary" android:id="@+id/tvVodEmptyTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/vod_no_content_title"/>
            <TextView android:textSize="13sp" android:textColor="@color/text_secondary" android:id="@+id/tvVodEmptySubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/vod_no_content_subtitle"/>
        </LinearLayout>
        <FrameLayout android:layout_gravity="bottom|center_horizontal" android:id="@+id/llAdsView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</LinearLayout>
