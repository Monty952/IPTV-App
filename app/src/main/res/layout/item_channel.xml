<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/cardChannel" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="6dp" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="16dp" app:cardElevation="2dp">
    <LinearLayout android:orientation="vertical" android:id="@+id/layoutCardContent" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="96dp" app:cardCornerRadius="14dp" app:cardElevation="0dp">
