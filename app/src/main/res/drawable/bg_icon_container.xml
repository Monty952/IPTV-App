<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp"/>
            <gradient android:startColor="#00afff" android:endColor="#03a9f4" android:angle="135" android:type="linear" android:centerColor="#03a9f4"/>
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <gradient android:startColor="#03a9f4" android:endColor="#03a9f4" android:angle="135" android:type="linear" android:centerColor="#03a9f4"/>
        </shape>
    </item>
</layer-list>
