<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/layoutPlayerChannel" android:background="@drawable/bg_mock_input" android:paddingLeft="12dp" android:paddingRight="12dp" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" android:foreground="?attr/selectableItemBackground" android:layout_marginVertical="3dp" android:paddingHorizontal="12dp">
    <ImageView android:id="@+id/ivPlayerChannelLogo" android:padding="2dp" android:layout_width="44dp" android:layout_height="36dp" android:src="@drawable/icon" android:scaleType="fitCenter" android:contentDescription="@string/app_name"/>
    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp">
        <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:ellipsize="end" android:id="@+id/tvPlayerChannelName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/channel_name_placeholder" android:maxLines="1"/>
        <TextView android:textSize="11sp" android:textColor="@color/text_secondary" android:ellipsize="end" android:id="@+id/tvPlayerChannelCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/general_category" android:maxLines="1"/>
    </LinearLayout>
    <ImageView android:id="@+id/ivNowPlaying" android:visibility="gone" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_play" android:contentDescription="@string/live" android:layout_marginStart="8dp" app:tint="@color/purple_accent"/>
</LinearLayout>
