<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:background="@color/bg_card" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/play_single_stream_title"/>
    <TextView android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/play_single_stream_desc"/>
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/stream_name_optional" app:boxBackgroundColor="@color/bg_secondary" app:boxStrokeColor="#1d8bf1" app:hintTextColor="#1d8bf1">
        <com.google.android.material.textfield.TextInputEditText android:textColor="@color/text_primary" android:id="@+id/etSingleStreamName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/stream_url_hint" app:boxBackgroundColor="@color/bg_secondary" app:boxStrokeColor="#1d8bf1" app:hintTextColor="#1d8bf1">
        <com.google.android.material.textfield.TextInputEditText android:textColor="@color/text_primary" android:id="@+id/etSingleStreamUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri"/>
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout android:gravity="end" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp">
        <com.google.android.material.button.MaterialButton android:textColor="@color/text_secondary" android:id="@+id/btnCancelSingleStream" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cancel" style="@style/Widget.MaterialComponents.Button.TextButton"/>
        <com.google.android.material.button.MaterialButton android:textColor="@color/white" android:id="@+id/btnPlaySingleStream" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/play_now" android:layout_marginStart="8dp" android:backgroundTint="#1d8bf1" app:cornerRadius="8dp"/>
    </LinearLayout>
</LinearLayout>
