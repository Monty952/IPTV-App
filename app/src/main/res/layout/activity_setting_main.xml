                        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp">
                            <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/parental_control"/>
                            <TextView android:textSize="12sp" android:textColor="@color/text_secondary" android:id="@+id/tvPinStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/status_parental_disabled"/>
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_primary" android:id="@+id/btnConfigurePin" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="14dp" android:text="@string/set_pin" android:textAllCaps="false" app:cornerRadius="12dp" app:icon="@drawable/ic_lock" app:iconTint="@color/brand_blue" app:strokeColor="@color/divider_color" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                    <com.google.android.material.button.MaterialButton android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_primary" android:id="@+id/btnManageLockedCategories" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="@string/lock_unlock_specific_categories" android:textAllCaps="false" app:cornerRadius="12dp" app:strokeColor="@color/divider_color" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                    <com.google.android.material.button.MaterialButton android:textSize="13sp" android:textColor="@color/live_red" android:id="@+id/btnDisablePin" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/disable_parental_control" android:textAllCaps="false" style="@style/Widget.MaterialComponents.Button.TextButton"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/app_preferences" android:layout_marginStart="4dp"/>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:strokeColor="@color/divider_color" app:strokeWidth="1dp">
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/settingRowTheme" android:background="?attr/selectableItemBackground" android:padding="16dp" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_theme_mode" app:tint="@color/brand_blue"/>
                        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp">
                            <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/theme_mode"/>
                            <TextView android:textSize="12sp" android:textColor="@color/text_secondary" android:id="@+id/tvCurrentThemeSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/theme_light_default"/>
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_arrow_forward" app:tint="@color/text_muted"/>
                    </LinearLayout>
                    <View android:background="@color/divider_color" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginLeft="16dp" android:layout_marginRight="16dp" android:layout_marginHorizontal="16dp"/>
                    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/settingRowLanguage" android:background="?attr/selectableItemBackground" android:padding="16dp" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_language" app:tint="@color/brand_blue"/>
                        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp">
                            <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_language"/>
                            <TextView android:textSize="12sp" android:textColor="@color/text_secondary" android:id="@+id/tvCurrentLanguageSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/lang_english_default"/>
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_arrow_forward" app:tint="@color/text_muted"/>
                    </LinearLayout>
                </LinearLayout>
