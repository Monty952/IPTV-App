<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/white" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/llNativeAdView" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="20dp" android:layout_alignParentEnd="true">
        <TextView android:textSize="12sp" android:textColor="@color/black" android:gravity="center" android:id="@+id/txtTime" android:background="@drawable/bg_ads_round" android:visibility="visible" android:layout_width="25dp" android:layout_height="25dp" android:text="3" android:fontFamily="@font/inter_medium"/>
        <ImageView android:id="@+id/imgClose" android:background="@drawable/bg_ads_round" android:padding="8dp" android:visibility="gone" android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_close" android:scaleType="fitXY"/>
    </RelativeLayout>
</RelativeLayout>
