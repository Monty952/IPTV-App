                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/layoutLiveBadge" android:background="@drawable/bg_badge_live" android:paddingLeft="7dp" android:paddingTop="2dp" android:paddingRight="7dp" android:paddingBottom="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="8dp" android:layout_alignParentTop="true" android:layout_alignParentStart="true" android:paddingHorizontal="7dp" android:paddingVertical="2dp">
                    <View android:background="@drawable/bg_badge_live" android:layout_width="4dp" android:layout_height="4dp" android:layout_marginEnd="4dp" android:backgroundTint="@color/white"/>
                    <TextView android:textSize="9sp" android:textStyle="bold" android:textColor="@color/white" android:id="@+id/tvLiveBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/live"/>
                </LinearLayout>
                <RelativeLayout android:gravity="center" android:background="@drawable/bg_fav_circle_badge" android:layout_width="30dp" android:layout_height="30dp" android:layout_margin="8dp" android:layout_alignParentBottom="true" android:layout_alignParentEnd="true">
                    <ImageButton android:id="@+id/btnFavorite" android:background="?attr/selectableItemBackgroundBorderless" android:padding="3dp" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_star_outline" android:scaleType="fitCenter" android:contentDescription="@string/favorites" app:tint="@color/white"/>
                </RelativeLayout>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:ellipsize="end" android:id="@+id/tvChannelName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/channel_name_placeholder" android:maxLines="1"/>
