<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/countryFilterItemRoot" android:background="@drawable/bg_country_item_unselected" android:paddingLeft="14dp" android:paddingTop="11dp" android:paddingRight="14dp" android:paddingBottom="11dp" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="2dp" android:layout_marginRight="2dp" android:layout_marginBottom="8dp" android:layout_marginHorizontal="2dp" android:paddingHorizontal="14dp" android:paddingVertical="11dp">
    <FrameLayout android:background="@drawable/bg_country_flag_box" android:layout_width="42dp" android:layout_height="42dp">
        <TextView android:textSize="22sp" android:layout_gravity="center" android:id="@+id/tvCountryFlag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/icon_globe"/>
    </FrameLayout>
    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="8dp">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" android:ellipsize="end" android:id="@+id/tvCountryName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/category_name_placeholder" android:maxLines="1"/>
            <TextView android:textSize="10sp" android:textStyle="bold" android:textColor="@color/brand_blue" android:id="@+id/tvUserCountryTag" android:background="@drawable/bg_category_pill" android:paddingLeft="6dp" android:paddingTop="1dp" android:paddingRight="6dp" android:paddingBottom="1dp" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/suggested" android:layout_marginStart="6dp" android:paddingHorizontal="6dp" android:paddingVertical="1dp"/>
        </LinearLayout>
        <TextView android:textSize="11sp" android:textColor="@color/text_secondary" android:ellipsize="end" android:id="@+id/tvCountrySubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/all_countries" android:maxLines="1"/>
    </LinearLayout>
    <TextView android:textSize="11sp" android:textStyle="bold" android:textColor="@color/cyan_light" android:id="@+id/tvChannelCount" android:background="@drawable/bg_category_pill" android:paddingLeft="8dp" android:paddingTop="3dp" android:paddingRight="8dp" android:paddingBottom="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/num_0" android:layout_marginEnd="10dp" android:paddingHorizontal="8dp" android:paddingVertical="3dp"/>
    <View android:id="@+id/radioIndicator" android:background="@drawable/radio_unselected" android:layout_width="22dp" android:layout_height="22dp"/>
</LinearLayout>
