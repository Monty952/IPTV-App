<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/purple_700"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:startColor="@color/brand_blue" android:endColor="@color/brand_blue" android:angle="135" android:type="linear"/>
            <stroke android:width="4dp" android:color="@color/divider_color"/>
        </shape>
    </item>
</selector>
