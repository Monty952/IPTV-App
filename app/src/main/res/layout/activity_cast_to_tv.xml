<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/cast_root" android:background="@color/app_bg" android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/topBar" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp">
        <ImageView android:id="@+id/btnBack" android:padding="6dp" android:focusable="true" android:visibility="gone" android:clickable="true" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_back" android:layout_centerVertical="true" android:contentDescription="@string/btn_back" android:layout_alignParentStart="true"/>
        <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_card_cast_phone_title" android:layout_centerVertical="true" android:fontFamily="sans-serif-medium" android:layout_marginStart="8dp" android:layout_toEndOf="@+id/btnBack"/>
        <ImageView android:id="@+id/btnInfo" android:padding="4dp" android:focusable="true" android:clickable="true" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_info_circle_header" android:layout_centerVertical="true" android:contentDescription="@string/information_title" android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <ScrollView android:id="@+id/scrollView" android:paddingBottom="24dp" android:scrollbars="none" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:layout_below="@+id/topBar">
        <LinearLayout android:orientation="vertical" android:id="@+id/contentContainer" android:paddingTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp">
            <LinearLayout android:gravity="center_horizontal" android:orientation="vertical" android:background="@drawable/bg_card_dark" android:paddingTop="32dp" android:paddingBottom="28dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp">
                <FrameLayout android:layout_width="96dp" android:layout_height="96dp">
                    <View android:background="@drawable/bg_circle_ir_glow" android:layout_width="96dp" android:layout_height="96dp"/>
                    <ImageView android:layout_gravity="center" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_cast_screen" android:contentDescription="@string/desc_screen_cast"/>
                </FrameLayout>
                <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/cast_mirror_wireless_title" android:fontFamily="sans-serif-medium"/>
                <TextView android:textSize="14sp" android:textColor="@color/text_secondary" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/cast_mirror_wireless_sub" android:lineSpacingExtra="3dp"/>
                <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="#ffffff" android:gravity="center" android:id="@+id/btnConnect" android:background="@drawable/bg_btn_purple_gradient" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="24dp" android:text="@string/cast_btn_connect" android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_alignParentBottom="true">
                <LinearLayout android:orientation="horizontal" android:id="@+id/llAdsView" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </RelativeLayout>
            <LinearLayout android:orientation="vertical" android:background="@drawable/bg_card_dark" android:paddingTop="20dp" android:paddingBottom="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:paddingStart="16dp" android:paddingEnd="16dp">
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/splash_purple" android:gravity="center" android:background="@drawable/bg_badge_number" android:layout_width="28dp" android:layout_height="28dp" android:text="@string/num_1"/>
                    <TextView android:textSize="14sp" android:textColor="@color/text_primary" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/cast_guide_step1" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:layout_marginStart="14dp"/>
                </LinearLayout>
                <View android:background="@color/divider_color" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/splash_purple" android:gravity="center" android:background="@drawable/bg_badge_number" android:layout_width="28dp" android:layout_height="28dp" android:text="@string/num_2"/>
                    <TextView android:textSize="14sp" android:textColor="@color/text_primary" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/cast_guide_step2" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:layout_marginStart="14dp"/>
                </LinearLayout>
                <View android:background="@color/divider_color" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:textSize="13sp" android:textStyle="bold" android:textColor="@color/splash_purple" android:gravity="center" android:background="@drawable/bg_badge_number" android:layout_width="28dp" android:layout_height="28dp" android:text="@string/num_3"/>
                    <TextView android:textSize="14sp" android:textColor="@color/text_primary" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/cast_guide_step3" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:layout_marginStart="14dp"/>
                </LinearLayout>
            </LinearLayout>
            <TextView android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="@string/cast_network_header" android:fontFamily="sans-serif-medium" android:layout_marginStart="4dp" android:letterSpacing="0.08"/>
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/cardWifiNetwork" android:background="@drawable/bg_card_dark" android:paddingTop="14dp" android:paddingBottom="14dp" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/bg_wifi_icon_box" android:contentDescription="@string/desc_wifi_icon"/>
                <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp">
                    <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" android:id="@+id/tvWifiSsid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cast_unknown_ssid" android:fontFamily="sans-serif-medium"/>
                    <TextView android:textSize="12sp" android:textColor="#34d399" android:id="@+id/tvWifiStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/status_connected" android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right_gray" android:contentDescription="@string/desc_open_wifi_settings"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
