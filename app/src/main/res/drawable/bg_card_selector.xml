<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_focused"/>
            <corners android:radius="12dp"/>
            <stroke android:width="2.5dp" android:color="@color/tv_focus_stroke"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_selected"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1.5dp" android:color="@color/purple_500"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_selected"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="@color/purple_accent"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="@color/divider_color"/>
        </shape>
    </item>
</selector>
