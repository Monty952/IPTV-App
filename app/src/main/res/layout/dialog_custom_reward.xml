<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:gravity="center" android:layout_gravity="bottom" android:orientation="vertical" android:background="@drawable/bg_ads_dialog_bottom" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <View android:background="@color/ads_dialog_text_color" android:layout_width="20dp" android:layout_height="2dp" android:layout_marginTop="10dp" android:alpha="0.5"/>
    <TextView android:textSize="14sp" android:textColor="@color/ads_dialog_text_color" android:gravity="center" android:id="@+id/txtMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Please stay 10 second to earn rewards." android:fontFamily="@font/inter_medium"/>
    <TextView android:textSize="12sp" android:textColor="@color/ads_dialog_text_color" android:gravity="center" android:id="@+id/txtLeftTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="Time left: " android:fontFamily="@font/inter_bold"/>
    <LinearLayout android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="10dp" android:layout_marginTop="20dp" android:layout_marginRight="10dp" android:layout_marginBottom="10dp" android:layout_marginHorizontal="10dp">
        <TextView android:textSize="13sp" android:textColor="@color/ads_dialog_text_color" android:gravity="center" android:id="@+id/txtCancel" android:background="@drawable/bg_ads_button_background" android:layout_width="0dp" android:layout_height="35dp" android:text="Cancel" android:layout_weight="1" android:fontFamily="@font/inter_medium" android:layout_marginEnd="10dp" android:letterSpacing="0.2"/>
        <TextView android:textSize="13sp" android:textColor="@color/ads_dialog_text_color" android:gravity="center" android:id="@+id/txtContinue" android:background="@drawable/bg_ads_button_background" android:layout_width="0dp" android:layout_height="35dp" android:text="Continue" android:layout_weight="1" android:fontFamily="@font/inter_medium" android:layout_marginStart="10dp" android:letterSpacing="0.2"/>
    </LinearLayout>
</LinearLayout>
