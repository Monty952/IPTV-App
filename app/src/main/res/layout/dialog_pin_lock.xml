<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:gravity="center_horizontal" android:orientation="vertical" android:background="@color/bg_card" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView android:id="@+id/ivPinIcon" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_lock" android:contentDescription="@string/parental_control"/>
    <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary" android:id="@+id/tvPinTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/enter_pin"/>
    <TextView android:textSize="13sp" android:textColor="@color/text_secondary" android:gravity="center" android:id="@+id/tvPinSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/parental_lock_category_msg"/>
    <com.google.android.material.textfield.TextInputLayout android:layout_width="200dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/pin_hint" app:boxBackgroundColor="@color/bg_secondary" app:boxStrokeColor="@color/purple_500" app:hintTextColor="@color/purple_accent">
        <com.google.android.material.textfield.TextInputEditText android:textSize="20sp" android:textColor="@color/text_primary" android:gravity="center" android:id="@+id/etPinCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLength="4" android:inputType="numberPassword" android:letterSpacing="0.3"/>
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout android:gravity="end" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp">
        <com.google.android.material.button.MaterialButton android:textColor="@color/text_secondary" android:id="@+id/btnCancelPin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cancel" style="@style/Widget.MaterialComponents.Button.TextButton"/>
        <com.google.android.material.button.MaterialButton android:textColor="@color/white" android:id="@+id/btnConfirmPin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/btn_unlock" android:layout_marginStart="8dp" android:backgroundTint="@color/purple_500" app:cornerRadius="8dp"/>
    </LinearLayout>
</LinearLayout>
